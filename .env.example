# DealerAddendums Marketing OS — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local

# ── Core ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dealeraddendums.com
ADMIN_PASSWORD=
DA_CRON_KEY=

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Google Tag Manager (optional; tags inert until set) ──────────────────────
# GTM container id (GTM-XXXXXXX). The container owns GA4 + the Google Ads
# conversion; the signup form pushes a `sign_up` dataLayer event for it to route.
NEXT_PUBLIC_GTM_ID=

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=allan@dealeraddendums.com

# ── CRM ──────────────────────────────────────────────────────────────────────
# NOTE: marketing no longer writes HubSpot directly — DA Platform owns it. These
# remain only if other marketing features still reference them.
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=23896347

# ── Self-serve signup → DA Platform provisioning (Phase 5) ───────────────────
# /api/leads calls DA Platform to create the Trial dealer/group. SELF_SERVE_API_KEY
# must match da-platform's .env.production exactly.
DA_PLATFORM_URL=https://app.dealeraddendums.com
SELF_SERVE_API_KEY=

# ── Cloudflare Turnstile (anti-abuse on signup) ──────────────────────────────
# Both blank in dev = verification skipped. Set both in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Social Scheduling ────────────────────────────────────────────────────────
BUFFER_API_KEY=
# Alternative: TYPEFULLY_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── DA Platform Supabase (READ-ONLY) ─────────────────────────────────────────
# Used by the Reputation Manager to read active dealers for review-request
# campaigns. NEVER write to this database. Leave blank to disable dealer
# segments (manual email paste still works).
DA_PLATFORM_SUPABASE_URL=https://byouefbebqgffhtfdggu.supabase.co
DA_PLATFORM_SUPABASE_SERVICE_KEY=

# ── Google Business Profile API — pending access approval from Google ────────
# The Reputation Manager runs on STUBBED mock reviews until these are set.
# Leave blank until Google approves the API access request.
# Once approved: add credentials and set GBP_LOCATION_NAME to
# accounts/XXXXXXX/locations/XXXXXXX to switch the module to live Google data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GBP_LOCATION_NAME=

# ── GA4 server-side events (Measurement Protocol) ────────────────────────────
# Powers the `form_start` and `trial_signup` events, which are what make the
# admin funnel's last two steps real instead of hardcoded zeros.
#
# WHY SERVER-SIDE: a trial signup is only real at email confirmation (Layer 0),
# and that click arrives from the applicant's email client — a different GA4
# session with no referrer. Firing it client-side there would attribute every
# trial to Direct and destroy cost-per-trial-by-channel. Sent server-side with
# the client id captured in the original session, attribution survives.
#
# ⚠️ THIS PROPERTY HAS TWO WEB DATA STREAMS, and it matters:
#   G-22M57J2LLS  ← the api_secret below is bound to this one. USE THIS.
#   G-NB7NWLQG5D  ← what the GTM container's GA4 config tag sends to.
# Both feed property 413858087, so reporting is unified. But a Measurement
# Protocol api_secret is STREAM-SCOPED, and a mismatched pair is not an error:
# Google answers 204 and silently drops the event. That cost a debugging cycle
# on 2026-09-11 — the payloads validated clean and returned 204 while nothing
# arrived. Always confirm receipt in Realtime, never trust the 204.
GA4_MEASUREMENT_ID=G-22M57J2LLS
# Same value, exposed to the browser ONLY so the client can prefer the matching
# per-stream `_ga_<ID>` session cookie (it falls back to any `_ga_*` cookie,
# because on this domain GTM writes _ga_NB7NWLQG5D). A measurement ID is public
# by design — it ships in the GTM container already. The api_secret is NOT.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-22M57J2LLS
#
# Create at: GA4 Admin → Data streams → (the web stream) → Measurement
# Protocol API secrets → Create. Server-side only; never prefix NEXT_PUBLIC_.
# Until this is set, lib/ga4-mp.ts is inert: every send is a logged no-op and
# nothing else breaks.
GA4_MP_API_SECRET=

# ── Dynamic Landing Engine (Phase 1) ─────────────────────────────────────────
# Kill switch — 1/true = every visitor gets the static hero (no generation, no cache reads)
HERO_KILL_SWITCH=0
# Max generation attempts per UTC day (over budget → static hero)
HERO_DAILY_GEN_BUDGET=150
# Hero cache TTL per context key, minutes
HERO_CACHE_TTL_MINUTES=360
# Models (defaults shown) — generation + cheap secondary validation pass
HERO_MODEL=claude-opus-4-8
HERO_VALIDATOR_MODEL=claude-haiku-4-5

# ── Google Ads / Analytics / Search Console (GOOGLE-MARKETING-INTEGRATION) ───
# Phase 1 is READ-ONLY. Every one of these is optional: a missing variable
# makes the matching portal section show a "not connected" state, never an error.
#
# NOTE: distinct from the GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above, which
# belong to the Google Business Profile (Reputation) integration. They may come
# from the same Google Cloud project, but keep the variables separate so
# revoking one integration cannot silently break the other.
#
# OAuth client (Google Cloud → APIs & Services → Credentials → Web application).
# Authorized redirect URI must be exactly:
#   https://www.dealeraddendums.com/api/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts the Google refresh token at rest (AES-256-GCM). REQUIRED before the
# Connect button appears — without it we could complete the handshake and then
# be unable to store the token safely. Generate with:  openssl rand -base64 32
# Rotating this invalidates the stored token; just click Connect Google again.
GOOGLE_TOKEN_ENC_KEY=

# Google Ads.
#
# NO DEVELOPER TOKEN IS NEEDED. Google retired developer tokens on 2026-09-09;
# the Ads client sends only the OAuth bearer token (plus login-customer-id when
# reaching a child account through a manager). GOOGLE_ADS_DEVELOPER_TOKEN is
# read nowhere and can be left blank or deleted.
GOOGLE_ADS_DEVELOPER_TOKEN=
#
# Both of the following are OPTIONAL. Accounts are discovered at runtime via
# customers:listAccessibleCustomers and picked in the Ads tab, so a new account
# needs no env change.
#
# Optional: which account the Ads tab preselects. With/without dashes both work.
GOOGLE_ADS_CUSTOMER_ID=
# Optional, and DANGEROUS IF WRONG: set this ONLY when the spending account is
# genuinely reached through a manager (MCC) that this Google user can access.
# A login-customer-id the user cannot access makes EVERY Ads call fail with
# USER_PERMISSION_DENIED — that was the live bug fixed on 2026-09-11. The client
# derives this per account from the real hierarchy, so leaving it blank is
# correct unless you know otherwise.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# GA4 property id — the NUMERIC id (Admin → Property Settings), not "G-XXXX".
GA4_PROPERTY_ID=

# Search Console property — OPTIONAL. The property is resolved at query time
# from Google's own sites.list, so a blank or wrong value self-corrects when the
# account has exactly one property.
#
# A URL-prefix property and a domain property are DIFFERENT objects, and asking
# for one you do not own returns 403 "User does not have sufficient permission"
# — which reads like a permissions problem but is a wrong-identifier problem.
# That was the live SEO-tab bug fixed on 2026-09-11: this was set to the
# URL-prefix form while the account only owns the domain property.
#
# Set it to one of the EXACT strings sites.list returns, e.g.
#   GSC_SITE_URL=sc-domain:dealeraddendums.com     ← what this account owns
#   GSC_SITE_URL=https://www.dealeraddendums.com/  ← a URL-prefix property
GSC_SITE_URL=
